# Terminates HTTPS (Let's Encrypt, automatic) and proxies to the API and the web dashboards.
# API_SITES / WEB_SITES are comma-separated host lists; they default to API_HOST / WEB_HOST.

# API (REST and Socket.IO). Every listed host is served, so screens and apps set up with an older
# address keep working after a domain change.
{$API_SITES} {
	encode gzip
	reverse_proxy api:4000
}

# Web dashboards (Next.js). WEB_HOST is the canonical address: any other listed host (www, an old
# address) redirects there, so users, cookies and CORS all see one origin.
{$WEB_SITES} {
	@other not host {$WEB_HOST}
	redir @other https://{$WEB_HOST}{uri} permanent
	encode gzip
	# Colour-scheme previews for the client (static pages in docker/previews): /1 to /5.
	@preview path /1 /2 /3 /4 /5
	handle @preview {
		root * /srv/previews
		rewrite * {path}.html
		file_server
	}
	handle {
		reverse_proxy web:3000
	}
}

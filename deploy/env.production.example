# Copy to .env.production on the server (repo root). Never commit the real file.

# Public hostname for the API. Without a domain use <ip-with-dashes>.sslip.io, e.g. 13-48-1-2.sslip.io
API_HOST=
# Public hostname for the web dashboards, e.g. app.13-48-1-2.sslip.io
WEB_HOST=
# Optional extra hosts, comma separated. API_SITES: every host serving the API (keep old ones so
# existing screens keep working). WEB_SITES: every web host; all but WEB_HOST redirect to it.
# e.g. API_SITES=api.example.com, 13-48-1-2.sslip.io
#      WEB_SITES=example.com, www.example.com, app.13-48-1-2.sslip.io
API_SITES=
WEB_SITES=
# Checkout of the Digital-Signage (dashboards) repo, relative to docker/
WEB_DIR=../../web
# Origins of the web dashboards, comma separated, e.g. https://app.13-48-1-2.sslip.io
CORS_ORIGINS=
# Web app origin used in reset and invite links
APP_PUBLIC_URL=

# openssl rand -hex 24 / openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

S3_REGION=eu-north-1
S3_BUCKET=

# Optional. Email: SES_REGION (Amazon SES via the instance role) or SMTP_URL (any relay).
SES_REGION=
SMTP_URL=
MAIL_FROM=Digital Signage <no-reply@localhost>
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Access code for the QA checklist at /qa (at least 8 characters). Leave empty to switch it off.
QA_KEY=
